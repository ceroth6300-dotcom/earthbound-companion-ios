
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <ApplicationId>org.earthbound.companion.iospreview</ApplicationId>
    <ApplicationTitle>EarthBound Companion</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <MtouchLink>None</MtouchLink>
    <CodesignKey>-</CodesignKey>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UI/Companion.Portable.UI.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>
</Project>
